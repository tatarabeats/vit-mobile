<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0E1A">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFF0C040"
            android:paddingBottom="18dp" />

        <!-- よく触るものを上に置く -->
        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="履歴"
            android:textColor="#FF0A0E1A"
            android:backgroundTint="#FFF0C040" />

        <Button
            android:id="@+id/btnClip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PCクリップ"
            android:textColor="#FF0A0E1A"
            android:backgroundTint="#FFE8D5A3" />

        <EditText
            android:id="@+id/clipUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="PCクリップ URL  (http://192.168.x.x:17890)"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#66FFFFFF"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/clipTokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PCクリップ token"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#66FFFFFF"
            android:inputType="text" />

        <Button
            android:id="@+id/saveClip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PCクリップ接続を保存"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="#FF2B3A5C" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autoEnterSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="自動送信"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnStartOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="起動"
            android:textColor="#FF0A0E1A"
            android:backgroundTint="#FF4ECB8B" />

        <Button
            android:id="@+id/btnStopOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="停止"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="#FF1A2440" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="更新を確認"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="#FF2B3A5C" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="14dp"
            android:background="#33F0C040" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自動送信"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/autoEnterInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="70dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#80FFFFFF"
            android:background="#FF1A2440"
            android:padding="12dp"
            android:textSize="13sp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/pickAutoEnter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="アプリを選ぶ"
                android:textColor="#FFFFFFFF"
                android:backgroundTint="#FF1A2440" />

            <Button
                android:id="@+id/saveAutoEnter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="保存"
                android:textColor="#FF0A0E1A"
                android:backgroundTint="#FFF0C040" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAutoSendDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="診断"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="#FF1A2440" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="除外アプリ"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:paddingTop="20dp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/excludedInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="70dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#80FFFFFF"
            android:background="#FF1A2440"
            android:padding="12dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/saveExcluded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保存"
            android:textColor="#FF0A0E1A"
            android:backgroundTint="#FFF0C040" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="14dp"
            android:background="#33F0C040" />

        <!-- ここから下は初回だけ触るもの。既定では畳んでおく -->
        <Button
            android:id="@+id/btnToggleAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="設定を開く"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="#FF1A2440" />

        <LinearLayout
            android:id="@+id/advancedBox"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="権限"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:paddingTop="18dp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/btnOverlayPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="他のアプリの上に表示"
                android:textColor="#FFFFFFFF"
                android:backgroundTint="#FF1A2440" />

            <Button
                android:id="@+id/btnAccessibilityPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ユーザー補助"
                android:textColor="#FFFFFFFF"
                android:backgroundTint="#FF1A2440" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Groq APIキー"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:paddingTop="20dp"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="gsk_..."
                android:inputType="textPassword"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#80FFFFFF"
                android:background="#FF1A2440"
                android:padding="12dp"
                android:autofillHints="password" />

            <Button
                android:id="@+id/saveApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存"
                android:textColor="#FF0A0E1A"
                android:backgroundTint="#FFF0C040" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Anthropic APIキー"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:paddingTop="20dp"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/anthropicKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="sk-ant-..."
                android:inputType="textPassword"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#80FFFFFF"
                android:background="#FF1A2440"
                android:padding="12dp"
                android:autofillHints="password" />

            <Button
                android:id="@+id/saveAnthropicKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存"
                android:textColor="#FF0A0E1A"
                android:backgroundTint="#FFF0C040" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/llmFixSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="文章を整える"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="辞書"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:paddingTop="20dp"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/dictionaryInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#80FFFFFF"
                android:background="#FF1A2440"
                android:padding="12dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/saveDictionary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存"
                android:textColor="#FF0A0E1A"
                android:backgroundTint="#FFF0C040" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ショートカット"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:paddingTop="20dp"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/snippetsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:gravity="top|start"
                android:hint="住所|和歌山県〇〇市〇〇町1-2-3"
                android:inputType="textMultiLine"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#80FFFFFF"
                android:background="#FF1A2440"
                android:padding="12dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/saveSnippets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存"
                android:textColor="#FF0A0E1A"
                android:backgroundTint="#FFF0C040" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GitHubトークン"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:paddingTop="20dp"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/githubTokenInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="github_pat_..."
                android:inputType="textPassword"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#80FFFFFF"
                android:background="#FF1A2440"
                android:padding="12dp"
                android:autofillHints="password" />

            <Button
                android:id="@+id/saveGithubToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存"
                android:textColor="#FF0A0E1A"
                android:backgroundTint="#FFF0C040" />

            <Button
                android:id="@+id/btnSendFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="フィードバックを送る"
                android:textColor="#FFFFFFFF"
                android:backgroundTint="#FF1A2440" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
