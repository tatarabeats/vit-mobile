<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0E1A"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="28dp">

        <!-- 見出しと状態 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFF0C040" />

        <TextView
            android:id="@+id/statusText"
            style="@style/Vit.Note"
            android:textSize="14sp" />

        <!-- 準備が足りない時だけ出す -->
        <LinearLayout
            android:id="@+id/setupCard"
            style="@style/Vit.Card"
            android:background="@drawable/warn_bg"
            android:visibility="gone">

            <TextView
                style="@style/Vit.CardTitle"
                android:textColor="#FFFF9A60"
                android:text="使う前に必要な設定" />

            <Button
                android:id="@+id/btnOverlayPerm"
                style="@style/Vit.Button"
                android:text="他のアプリの上に表示を許可" />

            <Button
                android:id="@+id/btnAccessibilityPerm"
                style="@style/Vit.Button"
                android:text="ユーザー補助をON" />

            <Button
                android:id="@+id/btnMicPerm"
                style="@style/Vit.Button"
                android:text="マイクを許可" />

            <TextView
                android:id="@+id/needKeyText"
                style="@style/Vit.Note"
                android:layout_marginTop="10dp"
                android:text="下の「詳細設定」で Groq APIキーを入れてください" />
        </LinearLayout>

        <Button
            android:id="@+id/btnHistory"
            style="@style/Vit.Button.Primary"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:textSize="16sp"
            android:text="履歴" />

        <!-- 自動送信 -->
        <LinearLayout style="@style/Vit.Card">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoEnterSwitch"
                style="@style/Vit.Switch"
                android:textStyle="bold"
                android:text="自動送信" />

            <TextView
                style="@style/Vit.Note"
                android:text="入力したあと送信ボタンまで押すアプリ。入力欄を選んでいなくても入れます" />

            <TextView
                android:id="@+id/autoEnterApps"
                style="@style/Vit.Field"
                android:minHeight="44dp" />

            <Button
                android:id="@+id/pickAutoEnter"
                style="@style/Vit.Button"
                android:text="アプリを選ぶ" />
        </LinearLayout>

        <!-- 除外アプリ -->
        <LinearLayout style="@style/Vit.Card">

            <TextView
                style="@style/Vit.CardTitle"
                android:text="除外アプリ" />

            <TextView
                style="@style/Vit.Note"
                android:text="録音の操作に反応しないアプリ（入力欄を選んでいる時は使えます）" />

            <TextView
                android:id="@+id/excludedApps"
                style="@style/Vit.Field"
                android:minHeight="44dp" />

            <Button
                android:id="@+id/pickExcluded"
                style="@style/Vit.Button"
                android:text="アプリを選ぶ" />
        </LinearLayout>

        <!-- 文字の整え -->
        <LinearLayout style="@style/Vit.Card">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/llmFixSwitch"
                style="@style/Vit.Switch"
                android:textStyle="bold"
                android:text="文章を整える" />

            <TextView
                style="@style/Vit.Label"
                android:text="辞書（よく間違う言葉。1行に1つ）" />

            <EditText
                android:id="@+id/dictionaryInput"
                style="@style/Vit.Field"
                android:minHeight="80dp"
                android:gravity="top|start"
                android:inputType="textMultiLine" />

            <TextView
                style="@style/Vit.Label"
                android:text="ショートカット（言った言葉を置き換える）" />

            <EditText
                android:id="@+id/snippetsInput"
                style="@style/Vit.Field"
                android:minHeight="80dp"
                android:gravity="top|start"
                android:inputType="textMultiLine" />

            <TextView
                style="@style/Vit.Note"
                android:text="書いた内容はその場で保存されます" />
        </LinearLayout>

        <!-- 詳細設定（ふだん触らないもの） -->
        <Button
            android:id="@+id/btnToggleAdvanced"
            style="@style/Vit.Button"
            android:layout_marginTop="18dp"
            android:text="詳細設定を開く" />

        <LinearLayout
            android:id="@+id/advancedBox"
            style="@style/Vit.Card"
            android:visibility="gone">

            <TextView
                style="@style/Vit.CardTitle"
                android:text="APIキー" />

            <TextView
                style="@style/Vit.Label"
                android:layout_marginTop="8dp"
                android:text="Groq（文字起こし・必須）" />

            <EditText
                android:id="@+id/apiKeyInput"
                style="@style/Vit.Field"
                android:inputType="textPassword"
                android:singleLine="true" />

            <TextView
                style="@style/Vit.Label"
                android:text="Anthropic（文章を整える・任意）" />

            <EditText
                android:id="@+id/anthropicKeyInput"
                style="@style/Vit.Field"
                android:inputType="textPassword"
                android:singleLine="true" />

            <TextView
                style="@style/Vit.CardTitle"
                android:layout_marginTop="22dp"
                android:text="困った時" />

            <Button
                android:id="@+id/btnAutoSendDiag"
                style="@style/Vit.Button"
                android:text="自動送信の記録を見る" />

            <Button
                android:id="@+id/btnOpenAccessibility"
                style="@style/Vit.Button"
                android:text="ユーザー補助の設定を開く" />

            <Button
                android:id="@+id/btnRestart"
                style="@style/Vit.Button"
                android:text="VIT を再起動" />

            <Button
                android:id="@+id/btnStopOverlay"
                style="@style/Vit.Button"
                android:text="VIT を止める" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUpdate"
            style="@style/Vit.Button"
            android:layout_marginTop="18dp"
            android:text="更新を確認" />
    </LinearLayout>
</ScrollView>
