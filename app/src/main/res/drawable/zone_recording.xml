<?xml version="1.0" encoding="utf-8"?>
<!-- 録音中だけ出る小さな赤ドット。ゾーン自体は透明のまま -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="center"
        android:width="12dp"
        android:height="12dp">
        <shape android:shape="oval">
            <solid android:color="#FFE04040" />
            <stroke android:width="2dp" android:color="#66000000" />
        </shape>
    </item>
</layer-list>
