<resources>
    <style name="Theme.VitMobile" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryVariant">@color/gold_bright</item>
        <item name="colorOnPrimary">@color/navy</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:colorBackground">#FF0A0E1A</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textColorPrimary">@color/vit_text_primary</item>
        <item name="android:textColorSecondary">@color/vit_text_secondary</item>
        <item name="android:textColorHint">@color/vit_text_hint</item>
    </style>

    <!-- ジェスチャーから叩く透明な入口。画面には一切出さない -->
    <style name="Theme.VitTrigger" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoDisplay">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- MainActivityだけ常時ダーク。他画面のDayNightテーマは変更しない。 -->
    <style name="Theme.VitMobile.Main" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#F0C040</item>
        <item name="colorPrimaryVariant">#F0C040</item>
        <item name="colorOnPrimary">#0A0E1A</item>
        <item name="colorSecondary">#F0C040</item>
        <item name="colorOnSecondary">#0A0E1A</item>
        <item name="colorAccent">#F0C040</item>
        <item name="colorSurface">#131A2E</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:colorBackground">#0A0E1A</item>
        <item name="android:windowBackground">#0A0E1A</item>
        <item name="android:statusBarColor">#0A0E1A</item>
        <item name="android:navigationBarColor">#131A2E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/vit_text_primary</item>
        <item name="android:textColorSecondary">@color/vit_text_secondary</item>
        <item name="android:textColorHint">@color/vit_text_hint</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.VitMobile.MainDialog</item>
        <item name="materialButtonStyle">@style/Vit.Button</item>
    </style>
    <style name="ThemeOverlay.VitMobile.MainDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">#F0C040</item>
        <item name="colorSecondary">#F0C040</item>
        <item name="colorSurface">#131A2E</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:colorBackground">#131A2E</item>
        <item name="android:textColorPrimary">@color/vit_text_primary</item>
        <item name="android:textColorSecondary">@color/vit_text_secondary</item>
        <item name="android:textColorHint">@color/vit_text_hint</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Vit.CardTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Vit.Label</item>
        <item name="buttonBarPositiveButtonStyle">@style/Vit.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Vit.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Vit.DialogButton</item>
    </style>
</resources>
