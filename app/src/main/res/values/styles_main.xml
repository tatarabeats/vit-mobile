<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Vit.* の親（中身なし） -->
    <style name="Vit" />

    <style name="Vit.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="Vit.CardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFF0C040</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Vit.Note">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#B3FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="Vit.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="Vit.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textColorHint">#66FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Vit.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="backgroundTint">#FF2B3A5C</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Vit.Button.Primary">
        <item name="android:textColor">#FF0A0E1A</item>
        <item name="backgroundTint">#FFF0C040</item>
    </style>

    <style name="Vit.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">44dp</item>
    </style>
</resources>
