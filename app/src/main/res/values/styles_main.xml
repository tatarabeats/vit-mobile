<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Vit" />
    <style name="Vit.TextHeading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#F0C040</item>
    </style>
    <style name="Vit.TextBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="Vit.TextNote" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#B3FFFFFF</item>
    </style>
    <style name="Vit.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>
    <style name="Vit.CardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/Vit.TextHeading</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="Vit.Note">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/Vit.TextNote</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
    <style name="Vit.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/Vit.TextBody</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>
    <style name="Vit.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/Vit.TextBody</item>
        <item name="android:textColorHint">#99FFFFFF</item>
    </style>
    <style name="Vit.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/Vit.TextBody</item>
        <item name="android:textColor">#F0C040</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">#F0C040</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Vit.Button.Primary" parent="Vit.Button">
        <item name="android:textColor">#0A0E1A</item>
        <item name="backgroundTint">#F0C040</item>
    </style>
    <style name="Vit.DialogButton" parent="Vit.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>
    <style name="Vit.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/Vit.TextBody</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
